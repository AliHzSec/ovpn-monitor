[Unit]
Description=ovpn-monitor VPN domain sniffer
Documentation=https://github.com/AliHzSec/ovpn-monitor
# Capture needs the tunnel interfaces to exist, so order after the network and
# the VPN services. Wants (not Requires) so the sniffer still runs if one VPN
# is absent — it simply skips the missing interface.
After=network-online.target openvpn-server@server.service wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
# --- Adjust these paths to match your install ---------------------------------
# -db MUST point at the SAME db.sqlite the panel (ovpnmonitor) uses; the panel
# writes it next to its own binary. SQLite WAL mode makes concurrent access from
# the two processes safe.
ExecStart=/opt/ovpn-monitor/sniffer \
    -db /opt/ovpn-monitor/db.sqlite \
    -ifaces tun0,wg0 \
    -ipp /etc/openvpn/server/ipp.txt \
    -wg-conf /etc/wireguard/wg0.conf \
    -flush 2m \
    -dedup 60s
Restart=always
RestartSec=5

# --- Privileges ---------------------------------------------------------------
# Raw packet capture requires CAP_NET_RAW; CAP_NET_ADMIN is needed to attach the
# BPF filter on some kernels. Running as root also grants read access to the
# root-owned wg0.conf / ipp.txt and to the panel's SQLite database.
User=root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# --- Hardening ----------------------------------------------------------------
ProtectSystem=strict
ReadWritePaths=/opt/ovpn-monitor
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
